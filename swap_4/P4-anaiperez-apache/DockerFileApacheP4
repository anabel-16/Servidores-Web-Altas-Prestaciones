FROM anaiperez-apache-image:p3


RUN apt-get update && apt-get install -y iptables


RUN a2enmod ssl \
    && a2ensite default-ssl \
    && mkdir -p /etc/apache2/ssl

COPY P4-anaiperez-certificados/certificado_anaiperez_bundle.crt /etc/apache2/ssl/certificado_anaiperez_bundle.crt
COPY P4-anaiperez-certificados/certificado_anaiperez.key /etc/apache2/ssl/certificado_anaiperez.key

RUN chmod 600 /etc/apache2/ssl/certificado_anaiperez.key
RUN chmod 644 /etc/apache2/ssl/certificado_anaiperez_bundle.crt

COPY P4-anaiperez-apache/anaiperez-apache-ssl.conf /etc/apache2/sites-available/anaiperez-apache-ssl.conf
RUN a2ensite anaiperez-apache-ssl.conf && a2dissite default-ssl


COPY P4-anaiperez-apache/P4-anaiperez-iptables-web/anaiperez-iptables-web.sh /anaiperez-iptables-web.sh
COPY P4-anaiperez-apache/P4-anaiperez-iptables-web/entrypoint.sh /entrypoint.sh


RUN chmod +x /anaiperez-iptables-web.sh /entrypoint.sh

EXPOSE 80
EXPOSE 443


ENTRYPOINT ["/entrypoint.sh"]

CMD ["apache2ctl", "-D", "FOREGROUND"]
